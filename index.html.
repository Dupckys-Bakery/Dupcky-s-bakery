<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Dupcki's Bakery</title>
<style>
:root{--navy:#0b4779;--blue:#65afd4;--pale:#dff4ff;--mint:#d9efdc;--text:#173e5d}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--text);font-family:Georgia,"Times New Roman",serif;background:white}button,input,textarea{font:inherit}a{text-decoration:none;color:inherit}
header{background:linear-gradient(90deg,#d9f1ff,#eaf8f1);position:sticky;top:0;z-index:30;border-bottom:1px solid #bdddea}
.nav{width:min(1180px,96%);margin:auto;height:72px;display:grid;grid-template-columns:1fr minmax(240px,350px) auto;align-items:center;gap:24px}
.links{display:flex;gap:27px;font-size:15px;font-weight:bold}.links a{display:flex;gap:7px;align-items:center}
.search{position:relative}.search input{width:100%;border:1.5px solid #8ebfd8;border-radius:999px;background:white;padding:11px 42px 11px 16px;outline:none}.search span{position:absolute;right:14px;top:9px;font-family:Arial;font-size:21px}
.cart{border:0;background:transparent;font-size:30px;color:var(--navy);cursor:pointer;position:relative}.badge{position:absolute;right:-4px;top:-7px;background:#579cbc;color:white;border-radius:50%;font:11px Arial;padding:3px 6px}
.hero{background:linear-gradient(90deg,#edf7f2,#f9ffff 57%,#e4f5fb);overflow:hidden}.heroIn{max-width:1220px;margin:auto;height:360px;display:grid;grid-template-columns:1fr 300px 1fr;align-items:center}
.copy{text-align:center;padding:25px}.script{font-family:"Brush Script MT","Segoe Script",cursive;color:var(--navy);font-weight:400}.copy h1{font-size:49px;line-height:1.05;margin:0 0 12px}.copy p{font-family:Arial;font-size:15px;line-height:1.45;max-width:300px;margin:0 auto 17px}
.btn{border:0;background:#5da8ce;color:white;border-radius:10px;padding:11px 20px;font-family:Arial;font-weight:700;cursor:pointer}.pill{border-radius:999px;padding:13px 27px}
.heroLogo{width:300px;height:300px;object-fit:contain;filter:drop-shadow(0 8px 12px #2c769922)}
.heroProd{height:100%;position:relative;display:flex;align-items:center}.heroProd video{width:100%;height:310px;object-fit:cover;border-radius:0 0 0 75px;box-shadow:-10px 10px 30px #234a6220}.heroText{position:absolute;left:-50px;bottom:48px;font-family:"Brush Script MT","Segoe Script",cursive;color:var(--navy);font-size:28px;transform:rotate(-5deg)}.bf{position:absolute;font-size:35px}.bf1{left:18px;bottom:25px}.bf2{right:44%;top:40px}.bf3{right:25%;top:88px}
.categories{background:linear-gradient(90deg,#dff4ff,#edf9ff);padding:13px}.catbox{max-width:1060px;margin:auto;background:#eaf7fbbb;border-radius:28px;display:grid;grid-template-columns:repeat(4,1fr);padding:10px 25px}.cat{text-align:center;font-weight:bold}.cicon{width:58px;height:58px;background:#d9efdc;border:2px solid white;border-radius:50%;margin:auto;display:grid;place-items:center;font:28px Arial;color:var(--navy)}.cat span{display:block;margin-top:6px}
.products{max-width:1200px;margin:auto;padding:20px 28px 30px}.head{display:flex;align-items:end;justify-content:space-between;margin:0 5px 12px}.head h2{font-size:36px;color:var(--navy);margin:0}.head .script{font-size:31px}
.grid{display:grid;grid-template-columns:repeat(5,1fr);gap:15px}.card{min-width:0}.card img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:11px;display:block}.card h3{font-size:15px;line-height:1.12;margin:7px 2px 2px;min-height:34px}.price{font-size:20px;font-weight:bold;color:var(--navy);margin:0 2px 7px}.add{width:100%;background:#5da8ce;border:0;color:white;border-radius:9px;padding:10px 5px;font-family:Arial;cursor:pointer}.promo{background:linear-gradient(#dff4ff,#caebf8);border-radius:18px;padding:15px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;min-height:100%}.promo .script{font-size:34px;line-height:1.05}.promo .but{font-size:52px}
.benefits{background:#dff4ff;padding:20px}.benefitIn{max-width:1120px;margin:auto;display:grid;grid-template-columns:repeat(4,1fr);gap:30px}.benefit{display:flex;align-items:center;gap:13px}.benefit .ic{font:34px Arial;color:var(--navy)}.benefit b{font-size:15px}.benefit small{display:block;font-family:Arial;margin-top:2px}
footer{background:linear-gradient(90deg,#effaff,#f3fbf2);padding:23px}.foot{max-width:1120px;margin:auto;display:grid;grid-template-columns:170px 1fr auto;align-items:center;gap:30px}.foot img{width:150px;height:95px;object-fit:contain}.footnav{display:flex;justify-content:center;gap:30px;font-size:13px}.copyr{font-size:12px;text-align:right}
.overlay{position:fixed;inset:0;background:#0005;display:none;z-index:40}.drawer{position:fixed;right:-430px;top:0;width:min(410px,94vw);height:100vh;background:white;z-index:50;transition:.25s;padding:22px;overflow:auto;box-shadow:-15px 0 40px #0003}.drawer.open{right:0}.overlay.open{display:block}.dtop{display:flex;justify-content:space-between;align-items:center}.close{border:0;background:#e7f4f9;border-radius:50%;width:34px;height:34px;font-size:23px}.item{display:grid;grid-template-columns:58px 1fr 34px;gap:10px;align-items:center;border-bottom:1px solid #e9eef0;padding:10px 0}.item img{width:58px;height:58px;object-fit:cover;border-radius:8px}.total{font-size:22px;font-weight:bold;margin:20px 0}
.modal{display:none;position:fixed;inset:0;background:#0006;z-index:60;align-items:center;justify-content:center;padding:15px}.modal.open{display:flex}.box{background:white;border-radius:18px;width:min(480px,100%);padding:22px}.box input,.box textarea{width:100%;margin:6px 0;padding:12px;border:1px solid #cfe0e7;border-radius:10px}.actions{display:flex;justify-content:flex-end;gap:8px;margin-top:8px}
@media(max-width:850px){.links{display:none}.nav{grid-template-columns:1fr auto}.search{display:block}.heroIn{height:auto;grid-template-columns:1fr}.copy{padding-top:35px}.heroLogo{margin:auto}.heroProd{height:300px}.heroText{left:20px}.grid{grid-template-columns:repeat(2,1fr)}.catbox{grid-template-columns:repeat(2,1fr);gap:18px}.benefitIn{grid-template-columns:repeat(2,1fr)}.head .script{display:none}.foot{grid-template-columns:1fr;text-align:center}.foot img{margin:auto}.footnav{flex-wrap:wrap}.copyr{text-align:center}}
</style>
<style>
/* ===== CORREÇÃO RESPONSIVA MOBILE ===== */
@media (max-width: 850px){
  body{overflow-x:hidden}
  header{position:sticky;top:0}
  .nav{
    width:100%;height:62px;padding:7px 12px;
    display:grid;grid-template-columns:1fr 46px;gap:10px
  }
  .links{display:none}
  .search{display:block;min-width:0}
  .search input{height:42px;font-family:Arial,sans-serif;font-size:14px}
  .cart{font-size:27px}

  .hero{position:relative}
  .heroIn{
    width:100%;height:auto;min-height:0;padding:24px 16px 20px;
    display:flex;flex-direction:column;gap:12px
  }
  .copy{order:1;padding:0;text-align:center;width:100%}
  .copy h1{font-size:38px;line-height:1.05;margin:0 auto 12px;max-width:360px}
  .copy p{font-size:14px;max-width:330px}
  .heroLogo{
    order:2;width:210px;height:210px;max-width:70vw;margin:0 auto;display:block;
    object-fit:contain
  }
  .heroProd{order:3;width:100%;height:auto;display:block;position:relative}
  .heroProd video{
    width:100%;height:auto;max-height:none;aspect-ratio:4/3;object-fit:cover;
    border-radius:20px;display:block
  }
  .heroText{
    position:static;transform:none;text-align:center;
    font-size:27px;line-height:1.05;padding:13px 5px 0
  }
  .bf{font-size:25px;pointer-events:none}
  .bf1{left:12px;bottom:auto;top:250px}
  .bf2{right:14px;left:auto;top:320px}
  .bf3{display:none}

  .categories{padding:14px 10px}
  .catbox{
    width:100%;padding:15px 8px;border-radius:22px;
    grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 8px
  }
  .cat span{font-size:14px;line-height:1.15}
  .cicon{width:54px;height:54px}

  .products{width:100%;padding:24px 12px}
  .head{display:block;text-align:center;margin-bottom:18px}
  .head h2{font-size:30px;line-height:1.1}
  .head .script{display:block;font-size:24px;margin-top:8px;white-space:normal}
  .grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 10px}
  .card{min-width:0;width:100%}
  .card img{width:100%;height:auto;aspect-ratio:1/1;object-fit:cover}
  .card h3{
    min-height:0;font-size:14px;line-height:1.2;margin:7px 2px 4px;
    overflow-wrap:anywhere
  }
  .price{font-size:18px;margin-bottom:7px}
  .add{font-size:13px;padding:10px 3px}
  .promo{min-height:250px;padding:12px}
  .promo .script{font-size:28px}

  .benefits{padding:22px 14px}
  .benefitIn{grid-template-columns:1fr;gap:18px;max-width:390px}
  .benefit{justify-content:flex-start}

  footer{padding:22px 14px}
  .foot{grid-template-columns:1fr;gap:15px;text-align:center}
  .foot img{width:135px;height:90px;margin:auto}
  .footnav{gap:15px;flex-wrap:wrap}
  .copyr{text-align:center}
}
@media (max-width: 390px){
  .copy h1{font-size:34px}
  .heroLogo{width:185px;height:185px}
  .head h2{font-size:27px}
  .head .script{font-size:21px}
  .grid{gap:16px 8px}
  .card h3{font-size:13px}
  .price{font-size:17px}
}
</style>

<style>.qty{border:0;background:#e7f4f9;color:var(--navy);border-radius:50%;width:28px;height:28px;font:700 18px Arial;cursor:pointer;margin:5px 3px}.add:disabled{opacity:.75}</style>
<style>.categories,.benefits{background-image:linear-gradient(rgba(229,247,255,.86),rgba(225,248,235,.86)),url(assets/padrao-doces-borboletas.png);background-size:auto,520px auto;background-repeat:repeat}.heroProd video{object-position:center}</style><style>.conePlaceholder{height:180px;display:flex;align-items:center;justify-content:center;background:#edf7f2;color:#426477;border-radius:16px}.cat[role=button]{cursor:pointer}.heroProd video{object-fit:contain;background:#e5f7ff}</style></head><body>
<script>document.addEventListener('DOMContentLoaded',function(){const box=document.querySelector('.heroProd');const image=box&&box.querySelector('img');if(!image)return;const video=document.createElement('video');video.src='data:video/mp4;base64,';video.autoplay=true;video.muted=true;video.loop=true;video.playsInline=true;video.preload='auto';video.setAttribute('aria-label',"Vídeo de apresentação da Dupcki's Bakery");image.replaceWith(video);video.play().catch(function(){});});</script>
<header><div class="nav"><nav class="links"><a href="#inicio">⌂ Início</a><a href="#produtos">♧ Produtos</a><a href="#sobre">♡ Sobre nós</a><a href="#contato">◌ Contato</a></nav><div class="search"><input id="search" placeholder="Buscar produto..."><span>⌕</span></div><button class="cart" onclick="toggleCart()">🛒<span id="count" class="badge">0</span></button></div></header>
<section id="inicio" class="hero"><div class="heroIn"><div class="copy"><h1 class="script">Mais do que doces,<br>momentos de<br>felicidade! ♡</h1><p>Doces artesanais feitos com muito amor para deixar seu dia mais doce!</p><button class="btn pill" onclick="document.getElementById('produtos').scrollIntoView()">Ver Produtos　›</button></div><img class="heroLogo" src="data:image/webp;base64," alt="Dupcki's Bakery"><div class="heroProd"><img src="assets/padrao-doces-borboletas.png" alt="Estampa ilustrada com brownies, morangos, copos da felicidade e borboletas"><div class="heroText">A vida<br>fica mais doce<br>com a Dupcki's ♡</div></div></div><span class="bf bf1">🦋</span><span class="bf bf2">🦋</span><span class="bf bf3">🦋</span></section>
<section class="categories"><div class="catbox"><div class="cat"><div class="cicon">▱</div><span>Brownies Recheados</span></div><div class="cat"><div class="cicon">♨</div><span>Copo da Felicidade</span></div><div class="cat" role="button" tabindex="0" onclick="showSpecials()" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();showSpecials()}"><div class="cicon">🍓</div><span>Sabores Especiais</span></div><div class="cat"><div class="cicon">☆</div><span>Mais Vendidos</span></div></div></section>
<section id="produtos" class="products"><div class="head"><h2>Nossos Produtos ♡</h2><div class="script">Cada detalhe feito com amor ♡</div></div><div id="grid" class="grid"></div></section>
<section id="sobre" class="benefits"><div class="benefitIn"><div class="benefit"><div class="ic">🚚</div><div><b>Entrega</b><small>Consulte disponibilidade</small></div></div><div class="benefit"><div class="ic">🛡</div><div><b>Pedido seguro</b><small>Atendimento direto</small></div></div><div class="benefit"><div class="ic">♡</div><div><b>Feito com amor</b><small>Qualidade em cada detalhe</small></div></div><div class="benefit"><div class="ic">◎</div><div><b>Peça pelo WhatsApp</b><small>Dupcki's Bakery</small></div></div></div></section>
<footer id="contato"><div class="foot"><img src="data:image/webp;base64,"><div class="footnav"><a href="#inicio">Início</a><a href="#produtos">Produtos</a><a href="#sobre">Sobre nós</a><a href="#contato">Contato</a></div><div class="copyr">© 2026 Dupcki's Bakery.<br>Todos os direitos reservados.</div></div></footer>
<div id="overlay" class="overlay" onclick="toggleCart()"></div><aside id="drawer" class="drawer"><div class="dtop"><h2>Seu carrinho</h2><button class="close" onclick="toggleCart()">×</button></div><div id="items"></div><div class="total">Total: <span id="total">R$ 0,00</span></div><button class="btn" style="width:100%" onclick="checkout()">Finalizar pelo WhatsApp</button></aside>
<div id="modal" class="modal"><div class="box"><h2>Finalizar pedido</h2><p>Preencha seus dados e envie o pedido para a Dupcki's Bakery.</p><input id="customer" placeholder="Seu nome"><input id="address" placeholder="Endereço ou escreva Retirada"><textarea id="obs" rows="3" placeholder="Observações do pedido"></textarea><div class="actions"><button class="close" style="width:auto;border-radius:999px;padding:0 15px" onclick="modal.classList.remove('open')">Voltar</button><button class="btn" onclick="sendOrder()">Enviar pedido</button></div></div></div>
<script>
const products=[{"id":0,"name":"Morango Tradicional","price":15.99,"img":"data:image/webp;base64,"},{"id":1,"name":"Maracujá","price":18.6,"img":"data:image/webp;base64,"},{"id":2,"name":"Brownie Recheado (Morango)","price":16.9,"img":"data:image/webp;base64,"},{"id":3,"name":"Oreo","price":15.99,"img":"data:image/webp;base64,"},{"id":4,"name":"Brownie Recheado (KitKat)","price":16.9,"img":"data:image/webp;base64,"},{"id":5,"name":"Brownie Recheado (Oreo)","price":16.9,"img":"data:image/webp;base64,"},{"id":6,"name":"Brownie Recheado (Paçoca com Morango)","price":16.9,"img":"data:image/webp;base64,"},{"id":7,"name":"Brownie Recheado (Paçoca)","price":16.9,"img":"data:image/webp;base64,"},{"id":8,"name":"Copo da Felicidade Chocolate","price":16.9,"img":"data:image/webp;base64,"},{"id":9,"name":"Copo da Felicidade Maracujá","price":16.9,"img":"data:image/webp;base64,"},{"id":10,"name":"Copo da Felicidade Oreo","price":16.9,"img":"data:image/webp;base64,"},{"id":11,"name":"Copo da Felicidade Paçoca","price":16.9,"img":"data:image/webp;base64,"},{"id":12,"name":"Copo da Felicidade Morango","price":16.9,"img":"data:image/webp;base64,"},{"id":13,"name":"Copo da Felicidade Ninho","price":16.9,"img":"data:image/webp;base64,"},{"id":14,"name":"Cone de morango cravejado","price":15,"img":"","category":"especiais"},{"id":15,"name":"Cone de Oreo","price":15,"img":"","category":"especiais"}];let cart={};
const brl=v=>v.toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
function showSpecials(){render(products.filter(p=>p.category==='especiais'));document.getElementById('produtos').scrollIntoView({behavior:'smooth'})}
function render(list=products){let cards=list.map(p=>`<article class="card">${p.img ? `<img src="${p.img}" alt="${p.name}" loading="lazy">` : `<div class="conePlaceholder">Foto em breve</div>`}<h3>${p.name}</h3><div class="price">${brl(p.price)}</div><button class="add" onclick="add(${p.id})">🛒　Adicionar</button></article>`);if(list===products)cards.splice(14,0,`<aside class="promo"><div class="but">🦋</div><div class="script">Adoce<br>seu dia<br>com a<br>Dupcki's ♡</div><button class="btn pill" onclick="toggleCart()">Fazer meu pedido　›</button></aside>`);grid.innerHTML=cards.join('')}
function add(id){cart[id]=(cart[id]||0)+1;update();saveCart();const b=typeof event!=='undefined'&&event.currentTarget;if(b){const old=b.textContent;b.textContent='✓ Adicionado';b.disabled=true;setTimeout(()=>{b.textContent=old;b.disabled=false},700)}} function rem(id){cart[id]--;if(cart[id]<=0)delete cart[id];update();saveCart()}
function update(){let q=0,t=0;items.innerHTML=Object.entries(cart).map(([id,n])=>{let p=products.find(x=>x.id===Number(id));if(!p)return '';q+=n;t+=p.price*n;return `<div class="item">${p.img ? `<img src="${p.img}" alt="${p.name}">` : `<span aria-hidden="true">♡</span>`}<div><b>${p.name}</b><br><button class="qty" onclick="rem(${id})" aria-label="Diminuir">−</button> <strong>${n}</strong> <button class="qty" onclick="addFromCart(${id})" aria-label="Aumentar">+</button><br><small>${brl(p.price)} cada</small></div><button class="close" onclick="removeItem(${id})" aria-label="Remover produto">×</button></div>`}).join('')||'<p>Seu carrinho está vazio.</p>';count.textContent=q;total.textContent=brl(t)}
function addFromCart(id){cart[id]=(cart[id]||0)+1;update();saveCart()}function removeItem(id){delete cart[id];update();saveCart()}function saveCart(){localStorage.setItem('dupcki-cart',JSON.stringify(cart))}
function toggleCart(){drawer.classList.toggle('open');overlay.classList.toggle('open')} function checkout(){if(!Object.keys(cart).length)return alert('Adicione pelo menos um produto.');modal.classList.add('open')}
function sendOrder(){let n=customer.value.trim();if(!n)return alert('Digite seu nome.');let a=address.value.trim(),o=obs.value.trim(),l=["Olá! Quero fazer um pedido na Dupcki's Bakery:",""],t=0;Object.entries(cart).forEach(([id,q])=>{let p=products[id];l.push(`• ${q}x ${p.name} — ${brl(p.price*q)}`);t+=p.price*q});l.push("",`Total: ${brl(t)}`,`Cliente: ${n}`,`Entrega/retirada: ${a||"A combinar"}`);if(o)l.push(`Observações: ${o}`);l.push("","Pode confirmar disponibilidade e forma de pagamento?");window.location.href="https://wa.me/5541996143080?text="+encodeURIComponent(l.join("\n"))}
search.oninput=e=>render(products.filter(p=>p.name.toLowerCase().includes(e.target.value.toLowerCase())));try{cart=JSON.parse(localStorage.getItem('dupcki-cart'))||{}}catch(e){cart={}}render();update();
</script></body></html>
